<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HelixExplorer.ViewModels"
             xmlns:services="using:HelixExplorer.Services"
             x:Class="HelixExplorer.Views.StatusCentreFlyout"
             x:DataType="vm:MainWindowViewModel"
             Focusable="True"
             Opacity="0"
             IsVisible="False"
             IsHitTestVisible="False"
             ZIndex="50"
             VerticalAlignment="Bottom"
             HorizontalAlignment="Right"
             Margin="0,0,12,36"
             KeyDown="OnKeyDown"
             PointerEntered="OnPointerEntered"
             PointerExited="OnPointerExited">
    <UserControl.RenderTransform>
        <TranslateTransform Y="12" />
    </UserControl.RenderTransform>
    <Border Background="{DynamicResource HelixContentCardBrush}"
            BorderBrush="{DynamicResource HelixBorderColor}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,12"
            MinWidth="340"
            MaxWidth="420"
            MaxHeight="400"
            BoxShadow="0 8 24 0 #40000000">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
                <TextBlock Text="Status centre"
                           FontWeight="SemiBold"
                           FontSize="14"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Command="{Binding StatusCentre.TogglePinCommand}"
                        Classes="toolButton"
                        Padding="6,4"
                        ToolTip.Tip="Keep the status centre open">
                    <Panel>
                        <PathIcon Data="{DynamicResource HelixIconPinGeometry}"
                                  Width="14" Height="14"
                                  Opacity="0.5"
                                  IsVisible="{Binding !StatusCentre.IsPinned}" />
                        <PathIcon Data="{DynamicResource HelixIconPinGeometry}"
                                  Width="14" Height="14"
                                  IsVisible="{Binding StatusCentre.IsPinned}" />
                    </Panel>
                </Button>
                <Button Grid.Column="2"
                        Command="{Binding CloseStatusCentreCommand}"
                        Classes="toolButton"
                        Padding="6,4"
                        ToolTip.Tip="Close status centre">
                    <PathIcon Data="{DynamicResource HelixIconDismissGeometry}"
                              Width="14" Height="14" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" RowDefinitions="Auto,Auto" DataContext="{Binding OperationReporter}">
                <Border IsVisible="{Binding HasActive}"
                        Background="{DynamicResource HelixToolbarBrush}"
                        CornerRadius="6"
                        Padding="12,10"
                        Margin="0,0,0,12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding ActiveDisplayTitle}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,Auto">
                            <ProgressBar x:Name="ActiveProgressBar"
                                         Minimum="0"
                                         Maximum="1"
                                         Value="{Binding Progress}"
                                         IsIndeterminate="{Binding IsIndeterminate}"
                                         Height="4"
                                         Opacity="{Binding ProgressBarOpacity}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ProgressPercentText}"
                                       FontSize="11"
                                       Opacity="0.7"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding ShowDeterminateProgress}" />
                        </Grid>
                        <TextBlock Text="{Binding ActiveDetail}"
                                   FontSize="11"
                                   Opacity="0.65"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding HasActiveDetail}" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="6">
                            <Button Command="{Binding PauseOperationCommand}"
                                    IsVisible="{Binding CanPauseOperation}"
                                    Classes="toolButton"
                                    Padding="6,4"
                                    ToolTip.Tip="Pause operation">
                                <PathIcon Data="{DynamicResource HelixIconPauseGeometry}"
                                          Width="14" Height="14" />
                            </Button>
                            <Button Command="{Binding ResumeOperationCommand}"
                                    IsVisible="{Binding CanResumeOperation}"
                                    Classes="toolButton"
                                    Padding="6,4"
                                    ToolTip.Tip="Resume operation">
                                <PathIcon Data="{DynamicResource HelixIconPlayGeometry}"
                                          Width="14" Height="14" />
                            </Button>
                            <Button Command="{Binding CancelOperationCommand}"
                                    IsVisible="{Binding CanCancelOperation}"
                                    Classes="toolButton"
                                    Padding="6,4"
                                    ToolTip.Tip="Cancel operation">
                                <PathIcon Data="{DynamicResource HelixIconDismissGeometry}"
                                          Width="14" Height="14"
                                          Foreground="{DynamicResource HelixIconDeleteBrush}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="1"
                           Text="No file operations yet."
                           FontSize="12"
                           Opacity="0.6"
                           Margin="0,4,0,8"
                           IsVisible="{Binding ShowIdleEmpty}" />
            </Grid>

            <DockPanel Grid.Row="2"
                       DataContext="{Binding OperationReporter}"
                       IsVisible="{Binding HasCompleted}">
                <TextBlock DockPanel.Dock="Top"
                           Text="Recent"
                           FontSize="11"
                           Opacity="0.6"
                           Margin="0,0,0,8" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Completed}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:OperationEntry">
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      Margin="0,4">
                                    <PathIcon Grid.Column="0"
                                              Width="16" Height="16"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Top"
                                              Data="{DynamicResource HelixIconCheckmarkGeometry}"
                                              Foreground="{DynamicResource HelixSuccessBrush}"
                                              IsVisible="{Binding Succeeded}" />
                                    <PathIcon Grid.Column="0"
                                              Width="16" Height="16"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Top"
                                              Data="{DynamicResource HelixIconInfoGeometry}"
                                              Foreground="{DynamicResource HelixDangerBrush}"
                                              IsVisible="{Binding Failed}" />
                                    <PathIcon Grid.Column="0"
                                              Width="16" Height="16"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Top"
                                              Data="{DynamicResource HelixIconDismissGeometry}"
                                              Foreground="{DynamicResource HelixSecondaryTextBrush}"
                                              IsVisible="{Binding Cancelled}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Message}"
                                               FontSize="12"
                                               VerticalAlignment="Top"
                                               TextWrapping="Wrap"
                                               MaxLines="2"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding Failed, Converter={StaticResource BoolToFailureBrushConverter}}" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding CompletedAt, Converter={StaticResource RelativeTimeConverter}}"
                                               FontSize="11"
                                               Opacity="0.5"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Top" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <Button Grid.Row="3"
                    Command="{Binding OperationReporter.ClearCompletedCommand}"
                    Content="Clear all"
                    Classes="toolButton"
                    Padding="6,4"
                    HorizontalAlignment="Left"
                    Margin="0,12,0,0"
                    IsVisible="{Binding OperationReporter.HasCompleted}"
                    ToolTip.Tip="Clear completed operations" />
        </Grid>
    </Border>
</UserControl>
