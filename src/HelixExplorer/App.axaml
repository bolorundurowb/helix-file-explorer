<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:HelixExplorer.Converters"
             xmlns:services="using:HelixExplorer.Services"
             x:Class="HelixExplorer.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://HelixExplorer/Controls/VirtualizingFileGrid.axaml" />
        <StyleInclude Source="avares://HelixExplorer/Controls/ToolButton.axaml" />
        <StyleInclude Source="avares://HelixExplorer/Styles/FilesTheme.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://HelixExplorer/Styles/IconResources.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="HelixChromeBrush" Color="#F9F9F9" />
                    <SolidColorBrush x:Key="HelixSidebarBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="HelixContentCardBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HelixSurfaceBrush" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="HelixFileAreaBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HelixAddressBarBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HelixAccentBrush" Color="#0078D4" />
                    <SolidColorBrush x:Key="HelixSelectionFillBrush" Color="#330078D4" />
                    <SolidColorBrush x:Key="HelixSelectionInactiveFillBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="HelixSelectionBarBrush" Color="#0078D4" />
                    <SolidColorBrush x:Key="HelixFocusBorderBrush" Color="#0078D4" />
                    <SolidColorBrush x:Key="HelixAccentForegroundBrush" Color="#000000" />
                    <SolidColorBrush x:Key="HelixToolbarBrush" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="HelixStatusBarBrush" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="HelixTabStripBrush" Color="#E8E8E8" />
                    <SolidColorBrush x:Key="HelixTabSelectedBrush" Color="#F8F8F8" />
                    <SolidColorBrush x:Key="HelixNavButtonBrush" Color="#E0E0E0" />
                    <SolidColorBrush x:Key="HelixBorderColor" Color="#E0E0E0" />
                    <SolidColorBrush x:Key="HelixSidebarSelectedBrush" Color="#186B6B6B" />
                    <SolidColorBrush x:Key="HelixSidebarPillBrush" Color="#1F000000" />
                    <!-- #0A000000 on white composites to #F5F5F5, so hover stays lighter than the selection tint. -->
                    <SolidColorBrush x:Key="HelixHoverBrush" Color="#0A000000" />
                    <SolidColorBrush x:Key="HelixEntryForegroundBrush" Color="#1A1A1A" />
                    <!-- Real colours, not an opacity fade. Secondary clears 4.5:1 on the tab strip and sidebar. -->
                    <SolidColorBrush x:Key="HelixSecondaryTextBrush" Color="#616161" />
                    <SolidColorBrush x:Key="HelixTertiaryTextBrush" Color="#6B6B6B" />
                    <SolidColorBrush x:Key="HelixMenuBackgroundBrush" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="HelixHomeCardBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HelixHomeCardHoverBrush" Color="#F0F0F0" />
                    <SolidColorBrush x:Key="HelixSettingsContentBrush" Color="#F9F9F9" />
                    <SolidColorBrush x:Key="HelixSettingsRowBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HelixSettingsNavSelectedBrush" Color="#1F000000" />
                    <SolidColorBrush x:Key="HelixSettingsNavAccentBar" Color="#0078D4" />
                    <SolidColorBrush x:Key="HelixToggleOnBrush" Color="#0078D4" />
                    <SolidColorBrush x:Key="HelixProgressBrush" Color="#0078D4" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#0078D4" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#0078D4" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#0078D4" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#0078D4" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#0078D4" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#0078D4" />
                    <SolidColorBrush x:Key="HelixSuccessBrush" Color="#107C10" />
                    <SolidColorBrush x:Key="HelixDangerBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="HelixGitStagedBrush" Color="#107C10" />
                    <SolidColorBrush x:Key="HelixGitModifiedBrush" Color="#9A6700" />
                    <SolidColorBrush x:Key="HelixGitConflictBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="HelixGitUntrackedBrush" Color="#6B6B6B" />
                    <SolidColorBrush x:Key="HelixIconCutBrush" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="HelixIconCopyBrush" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="HelixIconPasteBrush" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="HelixIconDeleteBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="HelixIconRenameBrush" Color="#1A1A1A" />
                    <x:Boolean x:Key="HelixTabTintVisible">True</x:Boolean>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="HelixChromeBrush" Color="#202020" />
                    <SolidColorBrush x:Key="HelixSidebarBrush" Color="#2D2D2D" />
                    <SolidColorBrush x:Key="HelixContentCardBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="HelixSurfaceBrush" Color="#252525" />
                    <SolidColorBrush x:Key="HelixFileAreaBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="HelixAddressBarBrush" Color="#2A2A2A" />
                    <SolidColorBrush x:Key="HelixAccentBrush" Color="#0078D4" />
                    <SolidColorBrush x:Key="HelixSelectionFillBrush" Color="#500078D4" />
                    <SolidColorBrush x:Key="HelixSelectionInactiveFillBrush" Color="#18FFFFFF" />
                    <SolidColorBrush x:Key="HelixSelectionBarBrush" Color="#0078D4" />
                    <SolidColorBrush x:Key="HelixFocusBorderBrush" Color="#0078D4" />
                    <SolidColorBrush x:Key="HelixAccentForegroundBrush" Color="#000000" />
                    <SolidColorBrush x:Key="HelixToolbarBrush" Color="#2A2A2A" />
                    <SolidColorBrush x:Key="HelixStatusBarBrush" Color="#252525" />
                    <SolidColorBrush x:Key="HelixTabStripBrush" Color="#202020" />
                    <SolidColorBrush x:Key="HelixTabSelectedBrush" Color="#2C2C2C" />
                    <SolidColorBrush x:Key="HelixNavButtonBrush" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="HelixBorderColor" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="HelixSidebarSelectedBrush" Color="#28A0A0A0" />
                    <SolidColorBrush x:Key="HelixSidebarPillBrush" Color="#25FFFFFF" />
                    <SolidColorBrush x:Key="HelixHoverBrush" Color="#0CFFFFFF" />
                    <SolidColorBrush x:Key="HelixEntryForegroundBrush" Color="#E6E6E6" />
                    <SolidColorBrush x:Key="HelixSecondaryTextBrush" Color="#A0A0A0" />
                    <SolidColorBrush x:Key="HelixTertiaryTextBrush" Color="#969696" />
                    <SolidColorBrush x:Key="HelixMenuBackgroundBrush" Color="#252526" />
                    <SolidColorBrush x:Key="HelixHomeCardBrush" Color="#2A2A2A" />
                    <SolidColorBrush x:Key="HelixHomeCardHoverBrush" Color="#333333" />
                    <SolidColorBrush x:Key="HelixSettingsContentBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="HelixSettingsRowBrush" Color="#2A2A2A" />
                    <SolidColorBrush x:Key="HelixSettingsNavSelectedBrush" Color="#25FFFFFF" />
                    <SolidColorBrush x:Key="HelixSettingsNavAccentBar" Color="#0078D4" />
                    <SolidColorBrush x:Key="HelixToggleOnBrush" Color="#0078D4" />
                    <SolidColorBrush x:Key="HelixProgressBrush" Color="#0078D4" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#0078D4" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#0078D4" />
                    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#0078D4" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#0078D4" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#0078D4" />
                    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#0078D4" />
                    <SolidColorBrush x:Key="HelixSuccessBrush" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="HelixDangerBrush" Color="#FF99A4" />
                    <SolidColorBrush x:Key="HelixGitStagedBrush" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="HelixGitModifiedBrush" Color="#F2CC60" />
                    <SolidColorBrush x:Key="HelixGitConflictBrush" Color="#FF99A4" />
                    <SolidColorBrush x:Key="HelixGitUntrackedBrush" Color="#A0A0A0" />
                    <SolidColorBrush x:Key="HelixIconCutBrush" Color="#E6E6E6" />
                    <SolidColorBrush x:Key="HelixIconCopyBrush" Color="#E6E6E6" />
                    <SolidColorBrush x:Key="HelixIconPasteBrush" Color="#E6E6E6" />
                    <SolidColorBrush x:Key="HelixIconDeleteBrush" Color="#FF99A4" />
                    <SolidColorBrush x:Key="HelixIconRenameBrush" Color="#E6E6E6" />
                    <x:Boolean x:Key="HelixTabTintVisible">True</x:Boolean>
                </ResourceDictionary>
                <!--
                    Active while Windows runs a contrast theme. AvaloniaThemeService recolours the six
                    system brushes in place from GetSysColor, so every alias below follows the OS theme.
                    Selection and hover fills stay transparent: row text is not swapped to HighlightText,
                    so a Highlight fill would fail contrast. Selection shows through the Highlight bar.
                    Keys not listed fall back to the Light or Dark dictionary, chosen by Window brightness.
                -->
                <ResourceDictionary x:Key="{x:Static services:AvaloniaThemeService.HighContrastDark}">
                    <SolidColorBrush x:Key="HelixSystemWindowBrush" Color="#000000" />
                    <SolidColorBrush x:Key="HelixSystemWindowTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="HelixSystemHighlightBrush" Color="#1AEBFF" />
                    <SolidColorBrush x:Key="HelixSystemHighlightTextBrush" Color="#000000" />
                    <SolidColorBrush x:Key="HelixSystemGrayTextBrush" Color="#3FF23F" />
                    <SolidColorBrush x:Key="HelixSystemHotlightBrush" Color="#FFFF00" />

                    <StaticResource x:Key="HelixChromeBrush" ResourceKey="HelixSystemWindowBrush" />
                    <StaticResource x:Key="HelixSidebarBrush" ResourceKey="HelixSystemWindowBrush" />
                    <StaticResource x:Key="HelixContentCardBrush" ResourceKey="HelixSystemWindowBrush" />
                    <StaticResource x:Key="HelixSurfaceBrush" ResourceKey="HelixSystemWindowBrush" />
                    <StaticResource x:Key="HelixFileAreaBrush" ResourceKey="HelixSystemWindowBrush" />
                    <StaticResource x:Key="HelixAddressBarBrush" ResourceKey="HelixSystemWindowBrush" />
                    <StaticResource x:Key="HelixToolbarBrush" ResourceKey="HelixSystemWindowBrush" />
                    <StaticResource x:Key="HelixStatusBarBrush" ResourceKey="HelixSystemWindowBrush" />
                    <StaticResource x:Key="HelixTabStripBrush" ResourceKey="HelixSystemWindowBrush" />
                    <StaticResource x:Key="HelixTabSelectedBrush" ResourceKey="HelixSystemWindowBrush" />
                    <StaticResource x:Key="HelixNavButtonBrush" ResourceKey="HelixSystemWindowBrush" />
                    <StaticResource x:Key="HelixMenuBackgroundBrush" ResourceKey="HelixSystemWindowBrush" />
                    <StaticResource x:Key="HelixHomeCardBrush" ResourceKey="HelixSystemWindowBrush" />
                    <StaticResource x:Key="HelixHomeCardHoverBrush" ResourceKey="HelixSystemWindowBrush" />
                    <StaticResource x:Key="HelixSettingsContentBrush" ResourceKey="HelixSystemWindowBrush" />
                    <StaticResource x:Key="HelixSettingsRowBrush" ResourceKey="HelixSystemWindowBrush" />
                    <StaticResource x:Key="HelixBorderColor" ResourceKey="HelixSystemWindowTextBrush" />

                    <StaticResource x:Key="HelixEntryForegroundBrush" ResourceKey="HelixSystemWindowTextBrush" />
                    <StaticResource x:Key="HelixSecondaryTextBrush" ResourceKey="HelixSystemWindowTextBrush" />
                    <StaticResource x:Key="HelixTertiaryTextBrush" ResourceKey="HelixSystemWindowTextBrush" />
                    <StaticResource x:Key="HelixIconCutBrush" ResourceKey="HelixSystemWindowTextBrush" />
                    <StaticResource x:Key="HelixIconCopyBrush" ResourceKey="HelixSystemWindowTextBrush" />
                    <StaticResource x:Key="HelixIconPasteBrush" ResourceKey="HelixSystemWindowTextBrush" />
                    <StaticResource x:Key="HelixIconRenameBrush" ResourceKey="HelixSystemWindowTextBrush" />
                    <StaticResource x:Key="HelixGitUntrackedBrush" ResourceKey="HelixSystemGrayTextBrush" />
                    <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="HelixSystemGrayTextBrush" />

                    <SolidColorBrush x:Key="HelixHoverBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="HelixSelectionFillBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="HelixSelectionInactiveFillBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="HelixSidebarSelectedBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="HelixSidebarPillBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="HelixSettingsNavSelectedBrush" Color="Transparent" />
                    <StaticResource x:Key="HelixSelectionBarBrush" ResourceKey="HelixSystemHighlightBrush" />

                    <StaticResource x:Key="HelixAccentBrush" ResourceKey="HelixSystemHighlightBrush" />
                    <StaticResource x:Key="HelixAccentForegroundBrush" ResourceKey="HelixSystemHighlightTextBrush" />
                    <StaticResource x:Key="HelixFocusBorderBrush" ResourceKey="HelixSystemHotlightBrush" />
                    <StaticResource x:Key="HelixSettingsNavAccentBar" ResourceKey="HelixSystemHighlightBrush" />
                    <StaticResource x:Key="HelixToggleOnBrush" ResourceKey="HelixSystemHighlightBrush" />
                    <StaticResource x:Key="HelixProgressBrush" ResourceKey="HelixSystemHighlightBrush" />
                    <StaticResource x:Key="ToggleSwitchFillOn" ResourceKey="HelixSystemHighlightBrush" />
                    <StaticResource x:Key="ToggleSwitchFillOnPointerOver" ResourceKey="HelixSystemHighlightBrush" />
                    <StaticResource x:Key="ToggleSwitchFillOnPressed" ResourceKey="HelixSystemHighlightBrush" />
                    <StaticResource x:Key="ToggleSwitchStrokeOn" ResourceKey="HelixSystemHighlightBrush" />
                    <StaticResource x:Key="ToggleSwitchStrokeOnPointerOver" ResourceKey="HelixSystemHighlightBrush" />
                    <StaticResource x:Key="ToggleSwitchStrokeOnPressed" ResourceKey="HelixSystemHighlightBrush" />

                    <x:Boolean x:Key="HelixTabTintVisible">False</x:Boolean>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Applied at startup from saved settings via IUiFontService. -->
            <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>

            <CornerRadius x:Key="HelixContentCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="HelixMenuCornerRadius">8</CornerRadius>
            <x:Double x:Key="HelixControlSpacing">8</x:Double>
            <x:Double x:Key="HelixRowHeight">32</x:Double>
            <x:Double x:Key="HelixEntryFontSize">14</x:Double>
            <x:Double x:Key="HelixSidebarFontSize">14</x:Double>
            <x:Double x:Key="HelixSidebarSectionFontSize">12</x:Double>
            <x:Double x:Key="HelixSidebarDefaultWidth">200</x:Double>
            <x:Double x:Key="HelixContextPrimaryRowHeight">48</x:Double>
            <x:Double x:Key="HelixContextSecondaryRowHeight">36</x:Double>
            <Thickness x:Key="HelixContentPadding">12</Thickness>

            <conv:FileSizeConverter x:Key="FileSizeConverter" />
            <conv:RelativeTimeConverter x:Key="RelativeTimeConverter" />
            <conv:BoolToSidebarBrushConverter x:Key="BoolToSidebarBrushConverter" />
            <conv:BoolToFailureBrushConverter x:Key="BoolToFailureBrushConverter" />
            <conv:EntryIconConverter x:Key="EntryIconConverter" />
            <conv:EntryIconBrushConverter x:Key="EntryIconBrushConverter" />
            <conv:GitFileStatusBrushConverter x:Key="GitFileStatusBrushConverter" />
            <conv:FolderColorConverter x:Key="FolderColorConverter" />
            <conv:FolderIconBrushConverter x:Key="FolderIconBrushConverter" />
            <conv:CutOpacityConverter x:Key="CutOpacityConverter" />
            <conv:SortColumnIsActiveConverter x:Key="SortColumnIsActiveConverter" />
            <conv:SortColumnHeaderWeightConverter x:Key="SortColumnHeaderWeightConverter" />
            <conv:SortColumnHeaderForegroundConverter x:Key="SortColumnHeaderForegroundConverter" />
            <conv:SortColumnIndicatorGeometryConverter x:Key="SortColumnIndicatorGeometryConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
