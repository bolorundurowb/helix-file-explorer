<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!--
      DEP-3: Core is first to opt into analyzers (not HelixExplorer/HelixExplorer.Windows yet -
      one project at a time). TreatWarningsAsErrors is already global (Directory.Build.props), so
      every rule this turns on is a potential build break; see the root .editorconfig's "DEP-3
      safety valve" section for the handful of rules dialed back pending a real compiler pass.
    -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="moment.net" />
    <PackageReference Include="SharpCompress" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HelixExplorer.Core.Tests" />
  </ItemGroup>
</Project>
