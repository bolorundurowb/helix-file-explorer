<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HelixExplorer.ViewModels"
             xmlns:views="using:HelixExplorer.Views"
             xmlns:controls="using:HelixExplorer.Controls"
              x:Class="HelixExplorer.Views.DualPaneView"
              x:DataType="vm:TabViewModel">
    <Panel>
        <Panel x:DataType="vm:TabViewModel" IsVisible="{Binding IsSettingsTab}">
            <views:SettingsPage DataContext="{Binding Settings}" />
        </Panel>

        <Panel IsVisible="{Binding IsBrowserTab}">
            <controls:PaneContentHost IsVisible="{Binding IsSinglePane}"
                                      Pane="{Binding LeftPane}"
                                      Home="{Binding Home}" />

            <Grid x:Name="DualGrid" IsVisible="{Binding IsDualPane}">
                <Grid x:Name="LeftHost" RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            Height="28"
                            Background="{DynamicResource HelixToolbarBrush}"
                            ClipToBounds="True">
                        <Grid>
                            <views:Omnibar x:Name="LeftAddress"
                                           Margin="4,0"
                                           VerticalAlignment="Center"
                                           DataContext="{Binding LeftPane}" />
                            <Border Height="2"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource HelixBorderColor}"
                                    IsHitTestVisible="False" />
                            <Border Height="2"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource HelixAccentBrush}"
                                    IsVisible="{Binding LeftPane.IsActive}"
                                    IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <controls:PaneContentHost Grid.Row="1"
                                              Pane="{Binding LeftPane}"
                                              Home="{Binding Home}" />
                    <Border Grid.Row="1"
                            IsVisible="{Binding LeftPane.IsActive}"
                            BorderBrush="{DynamicResource HelixFocusBorderBrush}"
                            BorderThickness="2"
                            CornerRadius="4"
                            IsHitTestVisible="False" />
                </Grid>

                <GridSplitter x:Name="Splitter"
                              Background="{DynamicResource HelixBorderColor}" />

                <Grid x:Name="RightHost" RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            Height="28"
                            Background="{DynamicResource HelixToolbarBrush}"
                            ClipToBounds="True">
                        <Grid>
                            <views:Omnibar x:Name="RightAddress"
                                           Margin="4,0"
                                           VerticalAlignment="Center"
                                           DataContext="{Binding RightPane}" />
                            <Border Height="2"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource HelixBorderColor}"
                                    IsHitTestVisible="False" />
                            <Border Height="2"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource HelixAccentBrush}"
                                    IsVisible="{Binding RightPane.IsActive, FallbackValue=False}"
                                    IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <controls:PaneContentHost Grid.Row="1"
                                              Pane="{Binding RightPane}"
                                              Home="{Binding Home}" />
                    <Border Grid.Row="1"
                            IsVisible="{Binding RightPane.IsActive, FallbackValue=False}"
                            BorderBrush="{DynamicResource HelixFocusBorderBrush}"
                            BorderThickness="2"
                            CornerRadius="4"
                            IsHitTestVisible="False" />
                </Grid>
            </Grid>
        </Panel>
    </Panel>
</UserControl>
