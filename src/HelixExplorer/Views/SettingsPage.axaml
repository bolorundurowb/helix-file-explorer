<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HelixExplorer.ViewModels"
             xmlns:theme="using:HelixExplorer.Core.Theming"
             xmlns:settings="using:HelixExplorer.Core.Settings"
             xmlns:models="using:HelixExplorer.Core.Models"
             xmlns:controls="using:HelixExplorer.Controls"
             xmlns:views="using:HelixExplorer.Views"
             x:Class="HelixExplorer.Views.SettingsPage"
             x:DataType="vm:SettingsPageViewModel"
             Background="{DynamicResource HelixSettingsContentBrush}">
    <UserControl.Resources>
        <views:AccentSwatchSelectedConverter x:Key="AccentSwatchSelectedConverter" />
        <views:TerminalGestureConflictConverter x:Key="TerminalGestureConflictConverter" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Border.gestureCapture">
            <Setter Property="Background" Value="{DynamicResource HelixAddressBarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HelixBorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Focusable" Value="True" />
        </Style>
        <Style Selector="Border.gestureCapture:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource HelixAccentBrush}" />
        </Style>
        <Style Selector="Button.accentSwatch Border.accentRing">
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.accentSwatch.selected Border.accentRing">
            <Setter Property="BorderBrush" Value="{DynamicResource HelixAccentBrush}" />
        </Style>
        <Style Selector="Button.accentSwatch PathIcon.accentCheck">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.accentSwatch.selected PathIcon.accentCheck">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </UserControl.Styles>
    <Grid ColumnDefinitions="220,*">

        <Border Grid.Column="0"
                Background="{DynamicResource HelixSidebarBrush}"
                BorderBrush="{DynamicResource HelixBorderColor}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Settings"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="16,16,16,12" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Sections}" Margin="6,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SettingsSection">
                                <Button Classes="settingsNavItem"
                                        Margin="0,1"
                                        Click="OnSectionClick">
                                    <Grid ColumnDefinitions="3,Auto,*" MinHeight="34">
                                        <Border Grid.Column="0"
                                                Width="3"
                                                CornerRadius="0,2,2,0"
                                                Background="{DynamicResource HelixSettingsNavAccentBar}"
                                                IsVisible="{Binding IsSelected}" />
                                        <Border Grid.Column="1" Grid.ColumnSpan="2"
                                                CornerRadius="4"
                                                Margin="4,0,0,0"
                                                Background="{DynamicResource HelixSettingsNavSelectedBrush}"
                                                IsVisible="{Binding IsSelected}" />
                                        <PathIcon Grid.Column="1"
                                                  Data="{Binding IconGeometry}"
                                                  Width="16" Height="16"
                                                  Margin="10,0,10,0"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Title}"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Padding="0,7,8,7"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20" MaxWidth="720" HorizontalAlignment="Left" Spacing="8">
                <TextBlock Text="{Binding SelectedTitle}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12" />
                <controls:WidestChildPanel ActiveIndex="{Binding SelectedSectionIndex}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Dual pane mode"
                               FontSize="14" FontWeight="SemiBold" Margin="2,4,0,4" />
                    <Border Classes="settingsRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Open tabs in dual pane mode" FontSize="14" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding Main.DefaultDualPane, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                    <Border Classes="settingsRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Default split direction"
                                       FontSize="14" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" MinWidth="160"
                                      x:CompileBindings="False"
                                      SelectedValue="{Binding Main.DefaultSplitOrientation, Mode=TwoWay}"
                                      SelectedValueBinding="{Binding Tag}">
                                <ComboBoxItem Content="Side by side"
                                              Tag="{x:Static models:PaneSplitOrientation.Vertical}" />
                                <ComboBoxItem Content="Stacked"
                                              Tag="{x:Static models:PaneSplitOrientation.Horizontal}" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <TextBlock Text="Tabs"
                               FontSize="14" FontWeight="SemiBold" Margin="2,12,0,4" />
                    <Border Classes="settingsRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Switch to new tabs when opening" FontSize="14" />
                                <TextBlock Text="Off keeps you on the current tab when using Open in new tab."
                                           FontSize="12" Opacity="0.6" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding Main.SwitchToNewTabOnOpen, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                    <Border Classes="settingsRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Restore tabs from last session" FontSize="14" />
                                <TextBlock Text="Reopen your previous tabs and window layout when Helix Explorer starts."
                                           FontSize="12" Opacity="0.6" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1"
                                          IsChecked="{Binding Main.RestoreSessionOnStartup, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                    <Border Classes="settingsRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Open in Terminal shortcut" FontSize="14" />
                                <TextBlock Text="Focus the field and press a key combination."
                                           FontSize="12" Opacity="0.6" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border x:Name="TerminalGestureCapture"
                                            Classes="gestureCapture"
                                            ToolTip.Tip="Press a key combination. The stored value is an Avalonia key gesture.">
                                        <TextBlock Text="{Binding Main.OpenInTerminalGesture}"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <Button Content="Reset"
                                            Click="OnResetTerminalGestureClick"
                                            Padding="10,4"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="Reset to default (Ctrl+`)" />
                                </StackPanel>
                                <TextBlock Text="{Binding Main.OpenInTerminalGesture, Converter={StaticResource TerminalGestureConflictConverter}}"
                                           Foreground="{DynamicResource HelixDangerBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           MaxWidth="260"
                                           IsVisible="{Binding Main.OpenInTerminalGesture, Converter={StaticResource TerminalGestureConflictConverter}, ConverterParameter=visible}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="4">
                    <Border Classes="settingsRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Theme" FontSize="14" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" MinWidth="150"
                                      SelectedItem="{Binding Main.Theme, Mode=TwoWay}">
                                <theme:ThemeMode>System</theme:ThemeMode>
                                <theme:ThemeMode>Light</theme:ThemeMode>
                                <theme:ThemeMode>Dark</theme:ThemeMode>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Classes="settingsRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Font" FontSize="14" />
                                <TextBlock Text="System uses the platform default UI font."
                                           FontSize="12" Opacity="0.6" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      MinWidth="180"
                                      ItemsSource="{Binding UiFontOptions}"
                                      SelectedItem="{Binding Main.SelectedUiFontOption, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="theme:UiFontOption">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Classes="settingsRow">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Accent colour" FontSize="14" />
                            <WrapPanel Orientation="Horizontal">
                                <Button Classes="settingsNavItem accentSwatch" Width="64" Height="64" Margin="0,0,10,10"
                                        Padding="0" Click="OnAccentClick" Tag=""
                                        Classes.selected="{Binding Main.AccentColorArgb, Converter={StaticResource AccentSwatchSelectedConverter}, ConverterParameter=default, TargetNullValue=True}">
                                    <Border Classes="accentRing" BorderThickness="2" CornerRadius="6" Padding="2">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <PathIcon Data="{DynamicResource HelixFolderIconGeometry}"
                                                          Width="28" Height="28" HorizontalAlignment="Center"
                                                          Foreground="{DynamicResource HelixSecondaryTextBrush}" />
                                                <TextBlock Text="Default" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <PathIcon Classes="accentCheck"
                                                      Data="{DynamicResource HelixIconCheckmarkGeometry}"
                                                      Width="14" Height="14"
                                                      HorizontalAlignment="Right" VerticalAlignment="Top"
                                                      Margin="0,1,1,0"
                                                      Foreground="{DynamicResource HelixEntryForegroundBrush}" />
                                        </Grid>
                                    </Border>
                                </Button>
                                <Button Classes="settingsNavItem accentSwatch" Width="64" Height="64" Margin="0,0,10,10"
                                        Padding="0" Click="OnAccentClick" Tag="#0078D4"
                                        Classes.selected="{Binding Main.AccentColorArgb, Converter={StaticResource AccentSwatchSelectedConverter}, ConverterParameter=#0078D4, TargetNullValue=False}">
                                    <Border Classes="accentRing" BorderThickness="2" CornerRadius="6" Padding="2">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <PathIcon Data="{DynamicResource HelixFolderIconGeometry}"
                                                          Width="28" Height="28" HorizontalAlignment="Center"
                                                          Foreground="#0078D4" />
                                                <TextBlock Text="Blue" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <PathIcon Classes="accentCheck"
                                                      Data="{DynamicResource HelixIconCheckmarkGeometry}"
                                                      Width="14" Height="14"
                                                      HorizontalAlignment="Right" VerticalAlignment="Top"
                                                      Margin="0,1,1,0"
                                                      Foreground="{DynamicResource HelixEntryForegroundBrush}" />
                                        </Grid>
                                    </Border>
                                </Button>
                                <Button Classes="settingsNavItem accentSwatch" Width="64" Height="64" Margin="0,0,10,10"
                                        Padding="0" Click="OnAccentClick" Tag="#107C10"
                                        Classes.selected="{Binding Main.AccentColorArgb, Converter={StaticResource AccentSwatchSelectedConverter}, ConverterParameter=#107C10, TargetNullValue=False}">
                                    <Border Classes="accentRing" BorderThickness="2" CornerRadius="6" Padding="2">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <PathIcon Data="{DynamicResource HelixFolderIconGeometry}"
                                                          Width="28" Height="28" HorizontalAlignment="Center"
                                                          Foreground="#107C10" />
                                                <TextBlock Text="Green" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <PathIcon Classes="accentCheck"
                                                      Data="{DynamicResource HelixIconCheckmarkGeometry}"
                                                      Width="14" Height="14"
                                                      HorizontalAlignment="Right" VerticalAlignment="Top"
                                                      Margin="0,1,1,0"
                                                      Foreground="{DynamicResource HelixEntryForegroundBrush}" />
                                        </Grid>
                                    </Border>
                                </Button>
                                <Button Classes="settingsNavItem accentSwatch" Width="64" Height="64" Margin="0,0,10,10"
                                        Padding="0" Click="OnAccentClick" Tag="#8764B8"
                                        Classes.selected="{Binding Main.AccentColorArgb, Converter={StaticResource AccentSwatchSelectedConverter}, ConverterParameter=#8764B8, TargetNullValue=False}">
                                    <Border Classes="accentRing" BorderThickness="2" CornerRadius="6" Padding="2">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <PathIcon Data="{DynamicResource HelixFolderIconGeometry}"
                                                          Width="28" Height="28" HorizontalAlignment="Center"
                                                          Foreground="#8764B8" />
                                                <TextBlock Text="Purple" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <PathIcon Classes="accentCheck"
                                                      Data="{DynamicResource HelixIconCheckmarkGeometry}"
                                                      Width="14" Height="14"
                                                      HorizontalAlignment="Right" VerticalAlignment="Top"
                                                      Margin="0,1,1,0"
                                                      Foreground="{DynamicResource HelixEntryForegroundBrush}" />
                                        </Grid>
                                    </Border>
                                </Button>
                                <Button Classes="settingsNavItem accentSwatch" Width="64" Height="64" Margin="0,0,10,10"
                                        Padding="0" Click="OnAccentClick" Tag="#00B294"
                                        Classes.selected="{Binding Main.AccentColorArgb, Converter={StaticResource AccentSwatchSelectedConverter}, ConverterParameter=#00B294, TargetNullValue=False}">
                                    <Border Classes="accentRing" BorderThickness="2" CornerRadius="6" Padding="2">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <PathIcon Data="{DynamicResource HelixFolderIconGeometry}"
                                                          Width="28" Height="28" HorizontalAlignment="Center"
                                                          Foreground="#00B294" />
                                                <TextBlock Text="Teal" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <PathIcon Classes="accentCheck"
                                                      Data="{DynamicResource HelixIconCheckmarkGeometry}"
                                                      Width="14" Height="14"
                                                      HorizontalAlignment="Right" VerticalAlignment="Top"
                                                      Margin="0,1,1,0"
                                                      Foreground="{DynamicResource HelixEntryForegroundBrush}" />
                                        </Grid>
                                    </Border>
                                </Button>
                                <Button Classes="settingsNavItem accentSwatch" Width="64" Height="64" Margin="0,0,10,10"
                                        Padding="0" Click="OnAccentClick" Tag="#E3008C"
                                        Classes.selected="{Binding Main.AccentColorArgb, Converter={StaticResource AccentSwatchSelectedConverter}, ConverterParameter=#E3008C, TargetNullValue=False}">
                                    <Border Classes="accentRing" BorderThickness="2" CornerRadius="6" Padding="2">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <PathIcon Data="{DynamicResource HelixFolderIconGeometry}"
                                                          Width="28" Height="28" HorizontalAlignment="Center"
                                                          Foreground="#E3008C" />
                                                <TextBlock Text="Pink" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <PathIcon Classes="accentCheck"
                                                      Data="{DynamicResource HelixIconCheckmarkGeometry}"
                                                      Width="14" Height="14"
                                                      HorizontalAlignment="Right" VerticalAlignment="Top"
                                                      Margin="0,1,1,0"
                                                      Foreground="{DynamicResource HelixEntryForegroundBrush}" />
                                        </Grid>
                                    </Border>
                                </Button>
                                <Button Classes="settingsNavItem accentSwatch" Width="88" Height="64" Margin="0,0,10,10"
                                        Padding="0" Click="OnAccentClick" Tag="#CC5500"
                                        Classes.selected="{Binding Main.AccentColorArgb, Converter={StaticResource AccentSwatchSelectedConverter}, ConverterParameter=#CC5500, TargetNullValue=False}">
                                    <Border Classes="accentRing" BorderThickness="2" CornerRadius="6" Padding="2">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <PathIcon Data="{DynamicResource HelixFolderIconGeometry}"
                                                          Width="28" Height="28" HorizontalAlignment="Center"
                                                          Foreground="#CC5500" />
                                                <TextBlock Text="Burnt orange" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <PathIcon Classes="accentCheck"
                                                      Data="{DynamicResource HelixIconCheckmarkGeometry}"
                                                      Width="14" Height="14"
                                                      HorizontalAlignment="Right" VerticalAlignment="Top"
                                                      Margin="0,1,1,0"
                                                      Foreground="{DynamicResource HelixEntryForegroundBrush}" />
                                        </Grid>
                                    </Border>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="4">
                    <Border Classes="settingsRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Default view mode" FontSize="14" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" MinWidth="150"
                                      x:CompileBindings="False"
                                      SelectedValue="{Binding Main.DefaultViewMode, Mode=TwoWay}"
                                      SelectedValueBinding="{Binding Tag}">
                                <ComboBoxItem Content="Details" Tag="{x:Static models:LayoutMode.Details}" />
                                <ComboBoxItem Content="List" Tag="{x:Static models:LayoutMode.List}" />
                                <ComboBoxItem Content="Grid" Tag="{x:Static models:LayoutMode.Grid}" />
                                <ComboBoxItem Content="Columns" Tag="{x:Static models:LayoutMode.Miller}" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Classes="settingsRow">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Default thumbnail size (grid view)" FontSize="14" />
                            <Slider Minimum="32" Maximum="256"
                                    Value="{Binding Main.DefaultThumbnailSize, Mode=TwoWay}"
                                    TickFrequency="16" IsSnapToTickEnabled="True" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="4">
                    <Border Classes="settingsRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Show hidden items" FontSize="14" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Main.ShowHiddenFiles, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                    <Border Classes="settingsRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Show file name extensions" FontSize="14" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Main.ShowFileExtensions, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                    <Border Classes="settingsRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Folder sort order" FontSize="14" />
                                <TextBlock Text="Choose whether folders appear before files, after files, or inline with files."
                                           FontSize="12" Opacity="0.6" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" MinWidth="220"
                                      x:CompileBindings="False"
                                      SelectedValue="{Binding Main.DirectorySort, Mode=TwoWay}"
                                      SelectedValueBinding="{Binding Tag}">
                                <ComboBoxItem Content="Folders first"
                                              Tag="{x:Static models:DirectorySortMode.FoldersFirst}" />
                                <ComboBoxItem Content="Files first"
                                              Tag="{x:Static models:DirectorySortMode.FilesFirst}" />
                                <ComboBoxItem Content="Mixed"
                                              Tag="{x:Static models:DirectorySortMode.MixedWithFiles}" />
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Classes="settingsRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="File size units" FontSize="14" />
                                <TextBlock Text="Binary uses KiB/MiB. Decimal uses KB/MB."
                                           FontSize="12" Opacity="0.6" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" MinWidth="150"
                                      SelectedItem="{Binding Main.SizeDisplay, Mode=TwoWay}">
                                <settings:SizeDisplayMode>Binary</settings:SizeDisplayMode>
                                <settings:SizeDisplayMode>Decimal</settings:SizeDisplayMode>
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="4">
                    <Border Classes="settingsRow">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Helix Explorer"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock FontSize="13" Opacity="0.85">
                                <Run Text="Version " />
                                <Run Text="{Binding AppVersion}" />
                            </TextBlock>
                            <TextBlock Text="{Binding CopyrightNotice}"
                                       FontSize="13"
                                       Opacity="0.7" />
                        </StackPanel>
                    </Border>
                    <Border Classes="settingsRow">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Updates"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding UpdateStatus}"
                                       FontSize="13"
                                       Opacity="0.85" />
                            <Button Content="Check for Updates"
                                    Command="{Binding CheckForUpdatesCommand}"
                                    HorizontalAlignment="Left"
                                    IsEnabled="{Binding !IsCheckingForUpdates}"
                                    Padding="16,8" />
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <TextBlock Grid.Column="0"
                                           Text="Check for updates automatically"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1"
                                              IsChecked="{Binding Main.AutoCheckForUpdates, Mode=TwoWay}" />
                            </Grid>
                            <Button Content="Download Update"
                                    Command="{Binding OpenReleaseUrlCommand}"
                                    HorizontalAlignment="Left"
                                    IsVisible="{Binding HasUpdate}"
                                    Padding="16,8" />
                        </StackPanel>
                    </Border>
                    <Border Classes="settingsRow">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Data &amp; logs"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Logs are written to your temp folder, versioned by release."
                                       FontSize="12"
                                       Opacity="0.6" />
                            <Button Content="Open logs folder"
                                    Command="{Binding OpenLogsFolderCommand}"
                                    HorizontalAlignment="Left"
                                    Padding="16,8" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </controls:WidestChildPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
