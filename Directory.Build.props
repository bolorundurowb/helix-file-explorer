<Project>
  <PropertyGroup>
    <Version>1.3.0</Version>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Copyright>Copyright © 2026 Winner-Timothy Bolorunduro</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>

    <!--
      DEP-6: the release workflow used to publish with DebugType=none / DebugSymbols=false, which
      discards debug info entirely - a crash report from a shipped build could not be symbolized
      back to even a method name. RepositoryUrl + PublishRepositoryUrl let each project's SourceLink
      package (below) stamp the exact commit into its PDB; the publish step embeds that PDB into the
      DLL/EXE itself (DebugType=embedded) instead of shipping none, so a stack trace from a user's
      machine can be resolved - source and all - straight from the single shipped binary.
    -->
    <RepositoryUrl>https://github.com/bolorundurowb/helix-file-explorer</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
