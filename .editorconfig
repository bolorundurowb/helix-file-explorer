# EditorConfig: https://editorconfig.org
# Values here follow this codebase's OBSERVED style (checked across HelixExplorer.Core,
# HelixExplorer, and HelixExplorer.Windows) rather than generic defaults, so this file does not
# itself imply a mass reformat. Line-ending split matches .gitattributes: everything is LF except
# the CRLF-forced VS tooling files (.slnx/.csproj/.props/.ps1).
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{slnx,csproj,props,ps1}]
end_of_line = crlf

[*.{json,yml,yaml}]
indent_size = 2

[*.cs]
indent_size = 4

# Using directives: System.* first, then alphabetical; no blank line between groups (observed
# throughout - e.g. System.Collections.Concurrent / System.Text / HelixExplorer.Core.* /
# Microsoft.Extensions.Logging with no separating blank line), directives outside the namespace.
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:suggestion

# File-scoped namespaces are used everywhere in this codebase (AGENTS.md calls this out explicitly).
csharp_style_namespace_declarations = file_scoped:suggestion

# Braces: Allman (open brace on its own line) for member/type/control-flow blocks, but a single-
# statement if/return body is routinely left brace-less on one line (e.g. `if (x is null) return;`).
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true
csharp_prefer_braces = when_multiline:suggestion

# `var` is used pervasively, including where the type is not immediately apparent from the RHS.
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# No `this.` qualification anywhere in the codebase.
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = when_on_single_line:suggestion
csharp_style_prefer_primary_constructors = true:suggestion

# Private/internal fields are `_camelCase` everywhere (e.g. `_options`, `_writer`, `_gate`).
dotnet_naming_rule.private_fields_underscore_camel_case.severity = suggestion
dotnet_naming_rule.private_fields_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_underscore_camel_case.style = underscore_camel_case

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, internal

dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

# HelixExplorer.Core analyzer baseline (AnalysisMode=Recommended is enabled there first).
# These four rules are demoted to IDE suggestions rather than silenced: every other Recommended
# rule stays build-breaking via TreatWarningsAsErrors. Each demotion has a specific reason, so a
# new violation is still worth looking at in the editor.
[src/HelixExplorer.Core/**/*.cs]
# CA1848 wants source-generated LoggerMessage delegates. Every logging call in Core is on a
# diagnostic path (git command failure, corrupt settings/session, archive read failure,
# fire-and-forget fault) - never a listing/filter/sort hot path - so the allocation saving does not
# pay for the indirection here.
dotnet_diagnostic.CA1848.severity = suggestion
# CA1068 wants CancellationToken last on IFileOperationService. The trailing optional
# IFileOperationControl? is deliberate (pause/resume is opt-in per call); reordering is a breaking
# signature change through Core, Windows, and the ViewModels for no behavioural gain.
dotnet_diagnostic.CA1068.severity = suggestion
# CA1716 flags IFileChangeWatcher.Stop() and IFolderViewPreferencesService.Set() as reserved words
# in other CLR languages. This is a single-language app shipping no public API, and both names are
# the clearest ones available.
dotnet_diagnostic.CA1716.severity = suggestion
# CA1720 flags SizeDisplayMode.Decimal. Binary vs Decimal is the domain vocabulary for KiB vs KB
# and is user-facing; renaming it to dodge the System.Decimal type name would be less clear.
dotnet_diagnostic.CA1720.severity = suggestion
