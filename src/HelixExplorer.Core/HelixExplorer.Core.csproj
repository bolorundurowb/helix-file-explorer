<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- Analyzers roll out one project at a time; Core is first. The four rules Core does not
         comply with are demoted to suggestions in .editorconfig (with per-rule reasons) rather
         than excluded from TreatWarningsAsErrors, so the build stays warning-free and every other
         Recommended rule breaks the build. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="moment.net" />
    <PackageReference Include="SharpCompress" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HelixExplorer.Core.Tests" />
  </ItemGroup>
</Project>
